# Kopiera till .env och fyll i egna värden. .env committas ALDRIG.

# Postgres-lösenord (väljs fritt vid första uppstart)
DB_PASSWORD=byt-mig

# Hemlig nyckel för HMAC-signering av admin- och "human"-tokens (lång slumpsträng)
TOKEN_SECRET=byt-mig-till-en-lang-slumpstrang

# Admin-lösenord för /admin
# Lösenord till /admin (statistik + officiella omröstningar).
# ADMIN har företräde; IDEAS_ADMIN_PASSWORD finns kvar som fallback.
ADMIN=byt-mig
IDEAS_ADMIN_PASSWORD=byt-mig

# Valfritt: max antal röster per IP och minut (default 40)
# RATE_LIMIT_PER_MIN=40

# SMTP för magic-link-utskick (autentiserad relä, t.ex. Postal)
IDEAS_SMTP_USER=din-smtp-anvandare
IDEAS_SMTP_PASS=ditt-smtp-losenord
